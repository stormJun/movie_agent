	white-space: pre;
	overflow: auto;
	margin-top: 10rpx;
	/* 支持代码块文本选择 */
	-webkit-user-select: text;
	user-select: text;
}
.wemark_block_code_content{
	color: #5b5b5b;
	font-size: 24rpx;
}

/* 表格横向滚动容器 */
.wemark_table_scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* 确保有足够的内边距显示滚动条 */
    padding-bottom: 12rpx;
    min-height: 50rpx;
}

/* 表格外层容器 */
.wemark_block_table_container{
    width: 100%;
    margin: 10px 0;
    /* 移除hidden属性，避免阻止滚动 */
    overflow-x: auto;
    /* position: relative; */
}

.wemark_block_table{
    border-spacing: 0;
    border-collapse: collapse;
    margin-top: 10px;
    margin-bottom: 10px;
    /* Rich-text table base styles (avoid tag selectors in component wxss). */
    min-width: 100%;
    width: auto !important;
    max-width: none;
    table-layout: auto;
    display: table;
    /* 支持表格文本选择 */
    -webkit-user-select: text;
    user-select: text;
}

.wemark_block_table_tr{
    display: table-row;
    border-top: 1px solid #e0e0e0;
}

.wemark_block_image_container {
	/* // 使用grid 完成9宫格 */
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	/* grid-template-rows: repeat(3, 1fr); */
	gap: 20rpx;
}

.wemark_block_table_tr:nth-child(2n) {
    background-color: #f8f8f8;
}

.wemark_inline_table_th,
.wemark_inline_table_td{
	display: table-cell;
	padding:5px;
	font-size:28rpx;
	word-break: break-all;
	border: 1px solid #e0e0e0;
	max-width: 350rpx;
    text-align: left;
    vertical-align: middle;
    /* 支持表格单元格文本选择 */
    -webkit-user-select: text;
    user-select: text;
}

.wemark_inline_table_td:last-child{
	/* border-top:1px solid #e0e0e0; */
}

.wemark_inline_table_th{
	background:#f0f0f0;
    font-weight: bold;
	/* border-top:1px solid #e0e0e0; */
}

.wemark_inline_strong{
	font-weight: bold;
	/* padding:0 5px; */
	word-wrap:break-word;
	/* 支持粗体文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_em{
	font-style: italic;
	/* padding:0 5px; */
	word-wrap:break-word;
	/* 支持斜体文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_strong_em{
	font-style: italic;
	font-weight: bold;
	padding:0 5px;
	word-wrap:break-word;
	/* 支持粗斜体文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_deleted{
	text-decoration: line-through;
	padding:0 5px;
	word-wrap:break-word;
	/* 支持删除线文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_image{
	--size: 180rpx;
	width: var(--size);
	height: var(--size);

	object-fit: contain;
	flex-shrink: 0;
	border: 1rpx solid #e0e0e0;
	border-radius: 10rpx;
	/* max-width: 350rpx; */
}

.wemark_inline_code{
	/* background:#f0f0f0; */
	padding:3px 5px;
	word-wrap:break-word;
	/* 支持内联代码文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_text{
	word-wrap:break-word;
	/* 支持内联文本选择 */
	-webkit-user-select: text;
	user-select: text;
}

.wemark_inline_link{
	display: inline;
	word-break: break-word;
	/* color: blue; */
	word-wrap:break-word;
	/* 支持链接文本选择 */
	-webkit-user-select: text;
	user-select: text;
}
